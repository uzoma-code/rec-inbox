# Copy to `.env` in the app root. Never commit `.env`.

# Session signing for sign-in cookies
AUTH_SECRET=

# Optional: Neon / Postgres for cross-device recs and accounts
DATABASE_URL=

# TMDB for where-to-stream lookups (get a free key at themoviedb.org)
TMDB_API_KEY=

# OpenAI for Possible New Faves similar picks (server-only; model is gpt-4o-mini)
OPENAI_API_KEY=
